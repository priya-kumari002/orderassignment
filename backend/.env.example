PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=secret
DB_NAME=order_mgmt

# Cloud DB — mysql:// or postgres:// both work (Render free Postgres uses postgres://)
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/order_mgmt
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false

# Optional — leave empty to run without Redis
REDIS_URL=

# Comma-separated frontend origins in production (Vercel URL)
# FRONTEND_URL=https://your-app.vercel.app

# Required in production — random long string
# AUTH_SECRET=
